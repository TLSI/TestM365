# Base de datos
DATABASE_URL=postgresql://testm365:testm365_dev@localhost:5433/testm365_dev

# Redis (puerto 6380 para no colisionar con forlopd-pro)
REDIS_HOST=localhost
REDIS_PORT=6380

# MinIO (puertos 9002/9003 para no colisionar con forlopd-pro)
MINIO_ENDPOINT=localhost
MINIO_PORT=9002
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password
MINIO_USE_SSL=false
MINIO_BUCKET=testm365

# JWT (mínimo 32 caracteres)
JWT_SECRET=testm365_jwt_secret_change_in_production_min32
JWT_REFRESH_SECRET=testm365_refresh_secret_change_in_production_min32
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200
PORTAL_URL=http://localhost:4300

# Azure AD — añadir cuando estén disponibles en portal.azure.com
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
AZURE_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# SharePoint (dominio del tenant, ej: tudespacho.sharepoint.com)
SHAREPOINT_TENANT_DOMAIN=

# Webhook secret para validar change notifications de Graph API
MICROSOFT_WEBHOOK_SECRET=
